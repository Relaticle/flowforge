{
    "name": "relaticle/flowforge",
    "description": "Flowforge is a lightweight Kanban board package for Filament that works with existing Eloquent models.",
    "keywords": [
        "Relaticle",
        "laravel",
        "flowforge"
    ],
    "homepage": "https://github.com/relaticle/flowforge",
    "support": {
        "issues": "https://github.com/relaticle/flowforge/issues",
        "source": "https://github.com/relaticle/flowforge"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "manukminasyan",
            "email": "manuk.minasyan1@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "filament/actions": "^5.0",
        "filament/forms": "^5.0",
        "filament/schemas": "^5.0",
        "filament/support": "^5.0",
        "filament/tables": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "suggest": {
        "filament/filament": "Required for BoardPage, BoardResourcePage, and FlowforgePlugin panel integration (^5.0)"
    },
    "require-dev": {
        "filament/filament": "^5.7",
        "larastan/larastan": "^3.11",
        "laravel/pint": "^1.30",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^10.11|^11.2",
        "pestphp/pest": "^4.7|^5.1",
        "pestphp/pest-plugin-arch": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.1|^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.43"
    },
    "autoload": {
        "psr-4": {
            "Relaticle\\Flowforge\\": "src/",
            "Relaticle\\Flowforge\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Relaticle\\Flowforge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse",
        "pest": "vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage",
        "pint": "vendor/bin/pint",
        "test": [
            "@pint",
            "@analyse",
            "@pest"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Relaticle\\Flowforge\\FlowforgeServiceProvider"
            ],
            "aliases": {
                "Flowforge": "Relaticle\\Flowforge\\Facades\\Flowforge"
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
